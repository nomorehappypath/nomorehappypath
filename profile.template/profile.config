# ─────────────────────────────────────────────────────────────────────────────
# PROFILE CONFIG — your project's requirements
# ─────────────────────────────────────────────────────────────────────────────
# Copy profile.template/ to profile/, then fill every value below. These values are
# substituted into the engine's {{PROFILE:key}} tokens to produce the active directive
# set. You never edit the engine; you only edit this file (and qa/domain_qa_appendices.md).
#
# Each key shows: what it is, a blank for YOUR value, and the original CRE example
# (commented) so you can see the shape of a real, filled-in profile.
# ─────────────────────────────────────────────────────────────────────────────

# The product / codebase name.
product_name: ""
# example: "CRE Intelligence"

# Who states WHAT to build and gives final product acceptance (non-technical by design).
product_owner: ""
# example: "Gerard"

# The owning organization.
org: ""
# example: "KPIMinds LLC"

# The repo(s) the harness governs (name: short purpose).
repos: []
# example:
#   - "cre_control_plane: backend / control plane / admin / sim"
#   - "cre_app: hosted + local client app"

# Absolute root path the repos live under.
project_root: ""
# example: "/path/to/your/projects"

# The global cross-worktree coordination board (lives OUTSIDE every git repo).
board_path: ""
# example: "/path/to/your/board"

# THE TWO DIFFERENT AI VENDORS. One implements, the other reviews — and they swap per
# task. The ONLY hard rule: on a single task the reviewer vendor != the implementer
# vendor. Same-vendor review is never the real gate (label it LIMITED_SELF_REVIEW).
implementer_vendor: ""
reviewer_vendor: ""
# example: implementer_vendor / reviewer_vendor are interchangeable pools, e.g.
#   "Claude (Anthropic)" and "Codex (OpenAI)" — whichever did NOT write the code reviews it.

# The production-equivalent DB — the authoritative one you must verify against.
# (A lighter unit-test DB is fine for speed but is NOT authoritative.)
primary_db: ""
# example: "Postgres (prod + shared dev). SQLite is used only for fast unit tests and is NOT authoritative."

# Project tooling (keep the rule, supply your tool).
test_command: ""      # example: "pytest"
build_command: ""     # example: "npm run build"
lint_command: ""      # example: "ruff check"
migrate_command: ""   # example: "alembic upgrade head"

# Start/stop/restart/migrate scripts — the operational contract (use these before manual
# process control).
lifecycle_scripts: []
# example:
#   - "scripts/server_restart.sh"
#   - "scripts/dev_start.sh"

# The set of environments the project ships to. Every channel must be verified or marked
# N/A with a reason. "Local dev" is the universal baseline.
deployment_channels: []
# example:
#   - "Local dev"
#   - "Cloud/SaaS browser"
#   - "Local install / local runner"

# Path to YOUR project's domain QA scenarios — your equivalent of cancel/continue
# matrices, isolation probes, escaped-defect checklists. Replace the EXAMPLE file.
domain_qa_appendices: ""
# example: "profile/qa/domain_qa_appendices.md"
#   (a CRE worked example ships at profile.template/qa/EXAMPLE_domain_qa_appendices.md)
